{
  "zotero": {
    "install_path": "YOUR_ZOTERO_INSTALL_PATH",
    "data_dir": "YOUR_ZOTERO_DATA_DIR",
    "storage_dir": "YOUR_ZOTERO_DATA_DIR\\storage",
    "sqlite_path": "YOUR_ZOTERO_DATA_DIR\\zotero.sqlite",
    "profile_name": "YOUR_PROFILE_NAME.default",
    "api_key": "YOUR_ZOTERO_API_KEY",
    "library_id": "YOUR_ZOTERO_USER_ID",
    "library_type": "user",
    "locale": "zh-CN"
  },
  "extraction": {
    "pdf_quality": "markdown",
    "preserve_tables": true,
    "preserve_formulas": true,
    "chunk_size": 2000,
    "chunk_overlap": 200,
    "max_pdfs_per_batch": 50
  },
  "notebooklm": {
    "mcp_enabled": true,
    "gemini_fallback": true,
    "gemini_api_key": "YOUR_GEMINI_API_KEY",
    "gemini_model": "gemini-2.5-pro",
    "default_notebook_name": "Research-{topic}",
    "max_sources_per_notebook": 100
  },
  "index": {
    "index_path": "PROJECT_ROOT\\data\\zotero_index.json",
    "vector_db_path": "PROJECT_ROOT\\data\\chromadb",
    "auto_update_on_startup": true
  }
}
